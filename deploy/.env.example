# Optional overrides for deploy/docker-compose.yml.
# Copy to deploy/.env only if you need to change something; no change is required.
#
# Host port for the web UI / API (container port stays 8080).
NETMON_HTTP_PORT=8080
#
# Time zone of the app container (logs). The UI shows times in the browser's zone.
# TZ=UTC
#
# Registry mirrors, e.g. when Docker Hub rate-limits pulls:
# NETMON_DB_IMAGE=mirror.gcr.io/timescale/timescaledb:2.31.0-pg16
# NETMON_INIT_IMAGE=mirror.gcr.io/library/busybox:1.37
# NETMON_NODE_IMAGE=mirror.gcr.io/library/node:22-slim
# NETMON_PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim
#
# Prebuilt image instead of building locally (no npm/PyPI access needed, e.g. on an
# office network that blocks package downloads). Then run:
#   docker compose -f deploy/docker-compose.yml pull netmon
#   docker compose -f deploy/docker-compose.yml up -d --no-build
# Tags: latest (main branch), a branch name such as phase2, sha-<commit>, or a version.
# NETMON_IMAGE=ghcr.io/shacharyekutiel/networkmonitor:latest
