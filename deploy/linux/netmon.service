[Unit]
Description=NetworkMonitor (network monitoring web application)
Wants=network-online.target
After=network-online.target
# install.sh adds a drop-in (netmon.service.d/10-postgresql.conf) that orders this unit
# after the local PostgreSQL service. The app itself retries the DB for 60 s.

[Service]
Type=simple
User=netmon
Group=netmon
Environment=NETMON_DATA_DIR=/var/lib/netmon
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/var/lib/netmon
ExecStart=/opt/netmon/venv/bin/netmon serve
Restart=on-failure
RestartSec=5
# Exit code 3 = another instance holds the advisory lock; do not restart-loop on it.
RestartPreventExitStatus=3
TimeoutStopSec=20

# Without running as root:
#   CAP_NET_RAW           privileged ICMP fallback (raw sockets)
#   CAP_NET_BIND_SERVICE  [2b-3] SNMP trap receiver on UDP 162 and syslog on UDP/TCP 514
#                         (opened only while the Traps / Syslog features are ON)
# [3] The flow receivers (UDP 2055 / 4739 / 6343, Flows feature) are > 1024: no capability.
# [3] Kerberos SSO keeps its keytab, krb5.conf and replay cache in /var/lib/netmon/run
#     (created by the app, 0700; the keytab is stored encrypted in the database).
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/netmon
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
