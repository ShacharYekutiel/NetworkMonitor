# HTTPS front end for NetworkMonitor.
#
# NETMON_FQDN comes from /etc/netmon-gitops/site.env (written by ops/bootstrap.sh).
# The certificate is issued by the organisation's internal CA (ops/make-csr.sh +
# ops/install-cert.sh); until then bootstrap installs a temporary self-signed one.
# Both live in /etc/netmon-gitops/tls/ on the host, mounted read-only at /etc/caddy/tls.
{
	# Certificates are managed by hand (internal CA): never try ACME / an internal CA.
	auto_https disable_redirects
	# Clients that send no SNI (or an unknown name, e.g. the server's IP) get our cert.
	default_sni {$NETMON_FQDN}
	admin localhost:2019
	servers {
		# HTTP/3 would need UDP 443 published as well; TCP only is enough here.
		protocols h1 h2
	}
}

(app) {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
	encode zstd gzip
	# [1.4.1] Security headers come from the app itself (Content-Security-Policy with
	# frame-ancestors, X-Frame-Options, X-Content-Type-Options, Referrer-Policy and, because
	# the app sees X-Forwarded-Proto: https, Strict-Transport-Security), so a native install
	# without Caddy has them too and framing follows Settings > Security. Caddy therefore
	# sets no Content-Security-Policy / X-Frame-Options of its own (a second, different
	# policy would override the setting).
	# "?" sets a header only when the response does not already carry it: no duplicates on
	# proxied responses, and Caddy's own answers (e.g. 502 while the app restarts) stay
	# covered. Keep the values identical to backend/netmon/services/security.py.
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options nosniff
		?Referrer-Policy same-origin
		-Server
	}
	# WebSocket (/ws) upgrades are proxied transparently by reverse_proxy.
	# Caddy does not trust client-supplied X-Forwarded-* (no trusted_proxies), so the
	# app (NETMON_TRUST_PROXY=true) sees X-Forwarded-For/-Proto/-Host set by Caddy only.
	reverse_proxy netmon:8080 {
		# Keep long-lived WebSocket connections across `caddy reload` for a while.
		stream_close_delay 5m
	}
}

# The app is served on the full name (from site.env) only.
# Kerberos SSO, phase 3: the AD SPN exists for the full name only (HTTP/<fqdn>), so the
# browser must always use it. No SSO directive is needed: reverse_proxy passes the
# `Authorization: Negotiate` request header and the `WWW-Authenticate` response header
# through unchanged; the OIDC callback is under /api; /noc and /ack are SPA routes.
https://{$NETMON_FQDN} {
	import app
}

# The org short DNS name (https://netmonitor, phase 3: moved here from the app block) and
# anything else on 443 (IP address, other names): send the browser to the canonical name,
# so SSO, the session cookie and the Origin check always use one host. The certificate
# keeps DNS:netmonitor as a SAN, so the short name redirects without a warning.
https://netmonitor, https:// {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
	redir https://{$NETMON_FQDN}{uri} permanent
}

# Port 80: redirect everything to HTTPS on the canonical name.
http:// {
	redir https://{$NETMON_FQDN}{uri} permanent
}
