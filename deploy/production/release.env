# THE release pin for production (deploy/production/release.env).
# A release (bump) PR changes only this file; merging it to main deploys it.
#
#   NETMON_VERSION  the app version (X.Y.Z, no leading "v").
#   NETMON_IMAGE    must be ghcr.io/shacharyekutiel/networkmonitor:<NETMON_VERSION>,
#                   optionally pinned to a digest: ...:<NETMON_VERSION>@sha256:<64 hex>.
#                   ":latest" (or any other tag) is rejected by ops/check-release.sh.
#
# .github/workflows/release.yml opens the bump PR automatically (version + digest).
NETMON_VERSION=1.3.1
NETMON_IMAGE=ghcr.io/shacharyekutiel/networkmonitor:1.3.1@sha256:2cc95ef05c5df1b93a27804900a62a954ed41e4f037a73c998a067d3e8c71f69
