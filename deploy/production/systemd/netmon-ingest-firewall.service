[Unit]
# OPTIONAL and NOT enabled by bootstrap/sync: only after you have written
# /etc/netmon-gitops/ingest-allow.conf, run: systemctl enable --now netmon-ingest-firewall
Description=NetworkMonitor traps/syslog/flow sender filter (iptables DOCKER-USER)
Documentation=file:///opt/netmon/deploy/production/README.md
After=docker.service
Requires=docker.service
# Re-applied whenever Docker is (re)started.
PartOf=docker.service
ConditionPathExists=/etc/netmon-gitops/ingest-allow.conf

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/netmon-gitops/gitops.env
ExecStart=/usr/local/lib/netmon-gitops/ingest-firewall.sh apply
ExecStop=/usr/local/lib/netmon-gitops/ingest-firewall.sh remove
SyslogIdentifier=netmon-ingest-firewall

[Install]
WantedBy=multi-user.target docker.service
