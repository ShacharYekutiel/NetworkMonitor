# Non-secret application settings for production (read by the netmon container).
# Secrets are NOT here: the DB password is generated into the netmon-data volume by the
# `init` service; tokens live only on the server under /etc/netmon-gitops/.
#
# Proxy-related settings (NETMON_TRUST_PROXY, NETMON_COOKIE_SECURE) are fixed in
# compose.yaml because they are tied to the Caddy front end, not a matter of taste.
# Server-specific overrides (e.g. an outbound HTTPS_PROXY for Telegram/e-mail alerts)
# go in /etc/netmon-gitops/app.env on the server, never in git.

TZ=Asia/Jerusalem
NETMON_LOG_LEVEL=info
NETMON_MAX_CONCURRENT_CHECKS=100
NETMON_DISCOVERY_CONCURRENCY=64
NETMON_DISCOVERY_RATE=100
