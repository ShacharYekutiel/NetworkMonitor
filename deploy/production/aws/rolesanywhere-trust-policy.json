{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NetMonitorServerCertificateOnly",
      "Effect": "Allow",
      "Principal": {
        "Service": "rolesanywhere.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession",
        "sts:SetSourceIdentity"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:rolesanywhere:<RA_REGION>:<ACCOUNT_ID>:trust-anchor/<TRUST_ANCHOR_ID>"
        },
        "StringEquals": {
          "aws:PrincipalTag/x509Subject/CN": "<CERT_CN>",
          "aws:PrincipalTag/x509Issuer/CN": "Mnidom-PKI-SERV-CA"
        }
      }
    }
  ]
}
